// ============================================================
//   LOGGING HELPER
// ============================================================
void sep(char c = '-', int n = 56) {
  for (int i = 0; i < n; i++) Serial.print(c);
  Serial.println();
}

void logOK(const String& msg)   { Serial.println("  [OK] " + msg); }
void logWARN(const String& msg) { Serial.println("  [!!] " + msg); }
void logINFO(const String& msg) { Serial.println("       " + msg); }

// ============================================================
//   LCD (thread-safe)
// ============================================================
void lcdShow(const String& l1, const String& l2 = "") {
  if (xSemaphoreTake(mutexLCD, pdMS_TO_TICKS(100)) == pdTRUE) {
    lcd.clear();
    lcd.setCursor(0, 0); lcd.print(l1.substring(0, 16));
    if (l2.length()) { lcd.setCursor(0, 1); lcd.print(l2.substring(0, 16)); }
    xSemaphoreGive(mutexLCD);
  }
}

void lcdStatus() {
  String s;
  if (!wifiOnline)      s = antrianSisa > 0 ? "[Offline " + String(antrianSisa) + "]" : "[Offline]";
  else if (sedangKirim) s = "[Kirim " + String(antrianSisa) + "]";
  else if (antrianSisa) s = "[Antri " + String(antrianSisa) + "]";
  else                  s = "[Online]";
  while (s.length() < 16) s += ' ';
  if (xSemaphoreTake(mutexLCD, pdMS_TO_TICKS(30)) == pdTRUE) {
    lcd.setCursor(0, 1); lcd.print(s.substring(0, 16));
    xSemaphoreGive(mutexLCD);
  }
}

