void jalankanDiagnostik(const String& id) {
  DynamicJsonDocument d(1536);
  String masalah = "";
  d["firmware"] = FIRMWARE_VERSION;
  d["core"]["presensi"] = CORE_PRESENSI; d["core"]["jaringan"] = CORE_JARINGAN;
  d["rfid"]["ok"] = (bool)rfidOK;  d["rfid"]["versionReg"] = String("0x") + String(rfidVersion, HEX);
  d["lcd"]["ok"]  = (bool)lcdOK;
  d["wifi"]["ssid"] = WiFi.SSID(); d["wifi"]["rssi"] = WiFi.RSSI(); d["wifi"]["ip"] = WiFi.localIP().toString();
  d["ntp"]["ok"] = (bool)ntpSynced;
  struct tm t; if (waktuSekarangTm(t)) d["ntp"]["waktu"] = formatTanggal(t) + " " + formatJam(t);
  d["memori"]["bebas"] = ESP.getFreeHeap(); d["memori"]["terendah"] = ESP.getMinFreeHeap(); d["memori"]["blokTerbesar"] = ESP.getMaxAllocHeap();
  d["flash"]["terpakai"] = (uint32_t)LittleFS.usedBytes(); d["flash"]["total"] = (uint32_t)LittleFS.totalBytes();
  d["antrian"]["kirim"] = (int)antrianSisa; d["antrian"]["deadLetter"] = hitungBaris(PATH_DEAD); d["antrian"]["ditolak"] = hitungBaris(PATH_DITOLAK);
  d["data"]["kartu"] = jumlahKartu; d["data"]["jadwal"] = jumlahJadwal; d["data"]["versi"] = versiDataLokal;
  d["uptimeDetik"] = (uint32_t)(millis() / 1000);
  d["tapTerakhirDetikLalu"] = lastTapMs ? (int32_t)((millis() - lastTapMs) / 1000) : -1;

  if (!rfidOK) masalah += "RFID tidak terdeteksi; ";
  if (!lcdOK) masalah += "LCD tidak merespons; ";
  if (!ntpSynced) masalah += "Waktu belum sinkron; ";
  if (WiFi.RSSI() < -80) masalah += "Sinyal WiFi lemah; ";
  if (ESP.getMaxAllocHeap() < 40000) masalah += "Memori terfragmentasi; ";
  if (LittleFS.totalBytes() && LittleFS.usedBytes() * 100 / LittleFS.totalBytes() > 85) masalah += "Flash hampir penuh; ";
  if (jumlahKartu == 0) masalah += "Data siswa kosong; ";
  kirimAck(id, masalah.length() == 0, masalah.length() ? masalah : String("Semua normal · ") + jumlahKartu + " kartu", &d);
}

void prosesPerintah(JsonObject cmd) {
  String id  = (const char*)(cmd["id"]  | "");
  String nm  = (const char*)(cmd["cmd"] | "");
  String arg = (const char*)(cmd["arg"] | "");
  double ts  = cmd["ts"] | 0.0;
  static String lastId = bacaLastCmd();
  if (!id.length() || id == lastId) return;
  lastId = id; tulisLastCmd(id);    // simpan DULU -> restart tidak berulang terus

  if (waktuValid() && ts > 0 && (double)epochMs() - ts > PERINTAH_KEDALUWARSA) {
    kirimAck(id, false, "Perintah kedaluwarsa (lebih dari 5 menit), diabaikan");
    return;
  }
  Serial.printf("[CMD] %s %s\n", nm.c_str(), arg.c_str());

  if (nm == "buzzer") { kirimUi(UI_BUZZER_TES); kirimAck(id, true, "Pola tes dibunyikan"); }
  else if (nm == "lcd") {
    int a = arg.indexOf('|'), b = arg.indexOf('|', a + 1);
    String l1 = a < 0 ? arg : arg.substring(0, a);
    String l2 = a < 0 ? "" : arg.substring(a + 1, b < 0 ? arg.length() : b);
    int detik = b < 0 ? 10 : constrain(arg.substring(b + 1).toInt(), 2, 120);
    kirimUi(UI_LCD, l1, l2, detik);
    kirimAck(id, true, String("Ditampilkan ") + detik + " detik");
  }
  else if (nm == "sync") {
    uint32_t v = ambilVersiServer();
    bool ok = unduhDataBaru() && pasangDataBaru(v);
    kirimAck(id, ok, ok ? String(jumlahKartu) + " kartu, " + jumlahJadwal + " baris jadwal" : "Gagal mengunduh data");
    kirimStatus();
  }
  else if (nm == "diagnostik") jalankanDiagnostik(id);
  else if (nm == "restart") {
    kirimAck(id, true, "Restart dalam 2 detik");
    kirimUi(UI_LCD, "Restart dari", "admin web", 5);
    vTaskDelay(pdMS_TO_TICKS(2000));
    ESP.restart();     // antrian & state harian sudah di flash
  }
  else kirimAck(id, false, "Perintah tidak dikenal");
}

// Return true bila admin sedang membuka halaman Perangkat
bool cekInbox() {
  String r;
  if (rtdbRequest("GET", "device/inbox", "", &r) != 200) return false;
  if (r == "null") return false;
  StaticJsonDocument<512> doc;
  if (deserializeJson(doc, r)) return false;
  if (doc["command"].is<JsonObject>()) prosesPerintah(doc["command"].as<JsonObject>());
  double w = doc["watching"] | 0.0;
  return waktuValid() && w > 0 && (double)epochMs() - w < WATCHING_BERLAKU_MS;
}

// ============================================================
//   TASK JARINGAN — WiFi + NTP + Firebase (CORE_JARINGAN)
// ============================================================
void taskJaringan(void* param) {
  Serial.printf("\n[JARINGAN] task aktif di core %d\n", xPortGetCoreID());
  rtdbClient.setInsecure();   // lihat catatan TLS di panduan
  uint32_t tWifi = 0, tNTP = 0, tLogin = 0, tStatus = 0, tVersi = 0, tPoll = 0, tDead = 0;
  uint32_t jedaLogin = 10000;
  bool watching = false, wifiPernahOffline = false;
  int gagal = 0; const int MAX_GAGAL = 5;

  for (;;) {
    // ---- WiFi
    if (millis() - tWifi > 5000) {
      tWifi = millis();
      bool st = WiFi.status() == WL_CONNECTED;
      if (st && !wifiOnline) {
        wifiOnline = true; ntpSynced = false;
        Serial.printf("[NET] WiFi pulih — IP %s\n", WiFi.localIP().toString().c_str());
        if (wifiPernahOffline) antrekanGangguan("WiFi_Reconnect", "IP: " + WiFi.localIP().toString());
      } else if (!st) {
        if (wifiOnline) {
          wifiOnline = false; firebaseOK = false; wifiPernahOffline = true; rtdbTutup();
          antrekanGangguan("WiFi_Disconnect", "RSSI terakhir: " + String(WiFi.RSSI()) + "dB");
        }
        WiFi.disconnect(false);
        vTaskDelay(pdMS_TO_TICKS(300));
        WiFi.begin(WIFI_SSID, WIFI_PASSWORD);
        uint32_t t0 = millis();
        while (WiFi.status() != WL_CONNECTED && millis() - t0 < 8000) vTaskDelay(pdMS_TO_TICKS(500));
      }
    }
    if (!wifiOnline) { sedangKirim = false; vTaskDelay(pdMS_TO_TICKS(500)); continue; }

    // ---- NTP
    if (!ntpSynced && millis() - tNTP > 10000) {
      tNTP = millis();
      configTime(GMT_OFFSET, DST_OFFSET, "pool.ntp.org", "time.google.com");
      struct tm t;
      if (getLocalTime(&t, 3000)) ntpSynced = true;
    }

    // ---- Login Firebase (backoff jika gagal; berhenti spam bila password alat salah)
    if (!firebaseOK && millis() - tLogin > jedaLogin) {
      tLogin = millis();
      if (pastikanToken() && kirimStatus()) {
        firebaseOK = true; jedaLogin = 10000;
        Serial.println("[NET] Firebase terhubung");
      } else {
        jedaLogin = authDitolak ? 10UL * 60 * 1000 : min<uint32_t>(jedaLogin * 2, 5UL * 60 * 1000);
        if (authDitolak) Serial.println("[NET] Login alat DITOLAK — cek DEVICE_EMAIL/PASSWORD/API_KEY");
      }
    }
    if (!firebaseOK) { sedangKirim = false; vTaskDelay(pdMS_TO_TICKS(500)); continue; }

    // ---- 1) PRIORITAS UTAMA: kirim antrian tap
    if (antrianSisa > 0) {
      String baris = bacaBarisPertama();
      if (baris.length() == 0) {
        if (queueOffsetNext > queueOffset) hapusBarisPertama();
        else antrianSisa = hitungAntrian();
      } else {
        sedangKirim = true;
        HasilKirim h = kirimBarisAntrian(baris);
        if (h == KIRIM_OK) { hapusBarisPertama(); gagal = 0; }
        else if (h == KIRIM_DITOLAK) {
          Serial.println("[NET] Ditolak server -> ditolak.jsonl");
          arsipkanBaris(PATH_DITOLAK, baris); jumlahDitolakGlob++;
          hapusBarisPertama(); gagal = 0;
        } else if (++gagal >= MAX_GAGAL) {
          Serial.println("[NET] Gagal 5x -> dead-letter");
          arsipkanBaris(PATH_DEAD, baris); jumlahDeadGlob++;
          hapusBarisPertama(); gagal = 0; firebaseOK = false;   // paksa cek ulang login
        } else {
          vTaskDelay(pdMS_TO_TICKS(2000));
        }
        sedangKirim = antrianSisa > 0;
      }
      // Saat antrian padat, perintah tetap dicek tapi jarang (10 dtk)
      if (millis() - tPoll > POLL_NORMAL_MS) { tPoll = millis(); watching = cekInbox(); }
      vTaskDelay(pdMS_TO_TICKS(50));
      continue;
    }
    sedangKirim = false;

    // ---- 2) Perintah dari web (adaptif)
    if (millis() - tPoll > (watching ? POLL_CEPAT_MS : POLL_NORMAL_MS)) { tPoll = millis(); watching = cekInbox(); }

    // ---- 3) Heartbeat status
    if (millis() - tStatus > INTERVAL_STATUS_MS) { tStatus = millis(); if (!kirimStatus()) firebaseOK = false; }

    // ---- 4) Data siswa/jadwal berubah di web -> unduh ulang otomatis
    if (millis() - tVersi > INTERVAL_VERSI_MS) {
      tVersi = millis();
      uint32_t v = ambilVersiServer();
      if (v && v != versiDataLokal) {
        Serial.printf("[DATA] Versi berubah %u -> %u, unduh ulang\n", versiDataLokal, v);
        if (unduhDataBaru()) pasangDataBaru(v);
        modeCacheOffline = false;
      }
    }

    // ---- 5) Kirim ulang dead-letter tiap 1 jam
    if (tDead == 0 || millis() - tDead > INTERVAL_DEAD_MS) {
      tDead = millis();
      int n = requeueDeadLetter();
      if (n > 0) { jumlahDeadGlob = 0; Serial.printf("[NET] %d dead-letter dikirim ulang\n", n); }
    }

    vTaskDelay(pdMS_TO_TICKS(100));
  }
}

// ============================================================
//   HELPER BOOT
// ============================================================
bool cobaWifiDenganBatas(uint32_t batasMs) {
  WiFi.mode(WIFI_STA);
  WiFi.begin(WIFI_SSID, WIFI_PASSWORD);
  uint32_t t0 = millis();
  while (WiFi.status()!=WL_CONNECTED && millis()-t0<batasMs) { delay(400); Serial.print("."); }
  Serial.println();
  return WiFi.status()==WL_CONNECTED;
}

bool cobaNtpDenganBatas(uint32_t batasMs, struct tm& tInfo) {
  configTime(GMT_OFFSET, DST_OFFSET, "pool.ntp.org", "time.google.com");
  uint32_t t0 = millis();
  while (!getLocalTime(&tInfo, 2000) && millis()-t0<batasMs) delay(300);
  return getLocalTime(&tInfo, 500);
}

// ============================================================
//   SETUP — boot offline-first (identik v11.1) + Firebase
// ============================================================
void setup() {
  Serial.begin(115200);
  delay(300);
  sep('='); Serial.printf("  PRESENSI RFID %s (Firebase) — MA Nurul Huda\n", FIRMWARE_VERSION); sep('=');

  mutexLCD   = xSemaphoreCreateMutex();
  mutexQueue = xSemaphoreCreateMutex();
  mutexData  = xSemaphoreCreateMutex();
  uiQueue    = xQueueCreate(4, sizeof(UiPesan));
  pinMode(BUZZ_PIN, OUTPUT); digitalWrite(BUZZ_PIN, LOW);
  resetStateRam();
  for (int i=0;i<MAX_ASING_HARIAN;i++) stateAsing[i].terisi=false;

  sep(); Serial.println("  [1/6] LCD I2C"); sep();
  Wire.begin(21,22); lcd.init(); lcd.backlight();
  lcdShow("MA Nurul Huda", String("Presensi ") + FIRMWARE_VERSION);

  sep(); Serial.println("  [2/6] RFID MFRC522"); sep();
  SPI.begin(); mfrc522.PCD_Init(); delay(100);
  rfidVersion = mfrc522.PCD_ReadRegister(MFRC522::VersionReg);
  rfidOK = !(rfidVersion==0x00 || rfidVersion==0xFF);
  if (!rfidOK) logWARN("MFRC522 tidak terdeteksi — cek wiring");
  else logOK("MFRC522 terdeteksi (VersionReg 0x" + String(rfidVersion, HEX) + ")");

  sep(); Serial.println("  [3/6] Flash Storage"); sep();
  if (!LittleFS.begin(true)) { logWARN("GAGAL mount LittleFS"); lcdShow("Flash Error!","Restart alat"); while(1) delay(1000); }
  // Bersihkan cache format lama (Apps Script) & sisa unduhan terputus
  const char* lama[] = {"/induk.json","/jadwal.json","/versi.txt","/induk11.json","/jadwal11.json","/versi11.txt","/jadwal111.json","/versi111.txt","/q.tmp"};
  for (const char* p : lama) LittleFS.remove(p);
  LittleFS.remove(PATH_UNDUH_TMP); LittleFS.remove(PATH_UNDUH_TMP2);
  antrianSisa = hitungAntrian();
  jumlahDeadGlob = hitungBaris(PATH_DEAD);
  jumlahDitolakGlob = hitungBaris(PATH_DITOLAK);
  logOK("LittleFS OK, antrian: " + String(antrianSisa));
  bool cacheTersedia = LittleFS.exists(PATH_CACHE_INDUK) && LittleFS.exists(PATH_CACHE_JADWAL);

  sep(); Serial.println("  [4/6] WiFi"); sep();
  lcdShow("Sambung WiFi...", WIFI_SSID);
  bool wifiOk = cobaWifiDenganBatas(BOOT_WIFI_TIMEOUT_MS);
  while (!wifiOk && !cacheTersedia) {   // alat baru tanpa cache: wajib online
    lcdShow("Tap Ditolak", "Menunggu Sinyal");
    wifiOk = cobaWifiDenganBatas(BOOT_WIFI_TIMEOUT_MS);
  }
  wifiOnline = wifiOk;
  if (wifiOk) logOK("WiFi — IP " + WiFi.localIP().toString()); else logWARN("WiFi gagal, mode cache offline");

  sep(); Serial.println("  [5/6] NTP"); sep();
  struct tm tInfo;
  bool ntpOk = false;
  if (wifiOnline) {
    lcdShow("Sync Waktu...", "");
    ntpOk = cobaNtpDenganBatas(BOOT_NTP_TIMEOUT_MS, tInfo);
    while (!ntpOk && !cacheTersedia) { lcdShow("Tap Ditolak","Menunggu Waktu"); ntpOk = cobaNtpDenganBatas(BOOT_NTP_TIMEOUT_MS, tInfo); }
  }
  ntpSynced = ntpOk;
  if (ntpOk) logOK("NTP — " + formatTanggal(tInfo) + " " + formatJam(tInfo)); else logWARN("NTP belum sinkron");

  sep(); Serial.println("  [6/6] Firebase & data siswa"); sep();
  // FIX v12.0.1: wajib diset SEBELUM request RTDB pertama. Dulu hanya di taskJaringan
  // (yg baru jalan setelah setup selesai) -> handshake TLS gagal -> kode -1 terus-menerus.
  rtdbClient.setInsecure();
  bool dataSiap = false;
  versiDataLokal = bacaVersiTersimpan();
  if (wifiOnline && ntpSynced) {
    lcdShow("Login server...", "");
    if (pastikanToken()) {
      firebaseOK = true;
      logOK("Login Firebase berhasil");
      uint32_t vServer = ambilVersiServer();
      if (cacheTersedia && vServer && vServer == versiDataLokal && muatCacheLama()) {
        dataSiap = true; logOK("Versi data sama — pakai cache");
      } else {
        lcdShow("Unduh data...", "Tunggu");
        if (unduhDataBaru()) {
          int nI = parseIndukDariFile(PATH_UNDUH_TMP), nJ = parseJadwalDariFile(PATH_UNDUH_TMP2);
          if (nI > 0 && nJ > 0) {
            LittleFS.remove(PATH_CACHE_INDUK);  LittleFS.rename(PATH_UNDUH_TMP,  PATH_CACHE_INDUK);
            LittleFS.remove(PATH_CACHE_JADWAL); LittleFS.rename(PATH_UNDUH_TMP2, PATH_CACHE_JADWAL);
            if (vServer) { tulisVersiTersimpan(vServer); versiDataLokal = vServer; }
            dataSiap = true;
            logOK(String(nI) + " kartu, " + nJ + " baris jadwal diunduh");
          } else {
            logWARN("Data di server kosong/rusak (" + String(nI) + " kartu, " + String(nJ) + " jadwal)");
          }
        }
        if (!dataSiap && cacheTersedia) dataSiap = muatCacheLama();
      }
    } else {
      logWARN(authDitolak ? "Login alat DITOLAK — periksa DEVICE_EMAIL / DEVICE_PASSWORD / FIREBASE_API_KEY"
                          : "Server Firebase tidak terjangkau");
      lcdShow(authDitolak ? "Login Alat Gagal" : "Server Offline", authDitolak ? "Cek kredensial" : "Pakai cache");
      delay(2000);
    }
  }

  if (!dataSiap) {
    if (cacheTersedia) { dataSiap = muatCacheLama(); modeCacheOffline = true; logWARN("MODE CACHE OFFLINE"); }
    else {
      logWARN("Belum ada data siswa — menunggu server");
      while (!dataSiap) {
        lcdShow("Tap Ditolak", jumlahKartu == 0 && firebaseOK ? "Data siswa kosong" : "Gagal ambil data");
        delay(5000);
        if (!wifiOnline) wifiOnline = cobaWifiDenganBatas(BOOT_WIFI_TIMEOUT_MS);
        if (wifiOnline && !ntpSynced) ntpSynced = cobaNtpDenganBatas(BOOT_NTP_TIMEOUT_MS, tInfo);
        if (wifiOnline && ntpSynced && pastikanToken() && unduhDataBaru()) {
          int nI = parseIndukDariFile(PATH_UNDUH_TMP), nJ = parseJadwalDariFile(PATH_UNDUH_TMP2);
          if (nI > 0 && nJ > 0) {
            LittleFS.rename(PATH_UNDUH_TMP, PATH_CACHE_INDUK); LittleFS.rename(PATH_UNDUH_TMP2, PATH_CACHE_JADWAL);
            uint32_t v = ambilVersiServer(); if (v) { tulisVersiTersimpan(v); versiDataLokal = v; }
            dataSiap = true; firebaseOK = true;
          }
        }
      }
    }
  }

  struct tm tNow;
  if (waktuSekarangTm(tNow)) cekResetHarian(tNow);
  sistemSiap = true;
  antrekanGangguan("Boot", String(FIRMWARE_VERSION) + ", " + jumlahKartu + " kartu, reset: " + String((int)esp_reset_reason()));

  sep('='); Serial.println("  RINGKASAN"); sep('=');
  Serial.printf("  %-20s : %d / %d\n", "Kartu", jumlahKartu, MAX_KARTU);
  Serial.printf("  %-20s : %d\n", "Jadwal", jumlahJadwal);
  Serial.printf("  %-20s : %d / dead %d / ditolak %d\n", "Antrian", (int)antrianSisa, (int)jumlahDeadGlob, (int)jumlahDitolakGlob);
  Serial.printf("  %-20s : %s\n", "Mode", modeCacheOffline ? "CACHE OFFLINE" : "ONLINE");
  Serial.printf("  %-20s : %u / blok %u\n", "Heap", ESP.getFreeHeap(), ESP.getMaxAllocHeap());
  Serial.printf("  %-20s : presensi=%d jaringan=%d\n", "Core", CORE_PRESENSI, CORE_JARINGAN);
  for (int i=0; i<jumlahKartu && i<3; i++)
    Serial.printf("  contoh: %-16s %-10s %s\n", daftarKartu[i].uid, daftarKartu[i].nis, daftarKartu[i].nama);
  sep('=');

  xTaskCreatePinnedToCore(taskPresensi, "Presensi", 8192,  NULL, 2, NULL, CORE_PRESENSI);
  xTaskCreatePinnedToCore(taskJaringan, "Jaringan", 16384, NULL, 1, NULL, CORE_JARINGAN);
  buzzerBoot();
  Serial.println("  SISTEM SIAP — DUAL-CORE AKTIF");
}

void loop() { vTaskDelay(pdMS_TO_TICKS(1000)); }
