int hitungBaris(const char* path) {
  File f = LittleFS.open(path, "r");
  if (!f) return 0;
  uint8_t buf[256]; int n = 0, len;
  while ((len = f.read(buf, sizeof(buf))) > 0)
    for (int i=0;i<len;i++) if (buf[i]=='\n') n++;
  f.close();
  return n;
}

int hitungAntrian() {
  if (!LittleFS.exists(PATH_QUEUE)) { queueOffset = queueOffsetNext = 0; return 0; }
  File p = LittleFS.open(PATH_QPOS, "r");
  if (p) { queueOffset = p.readString().toInt(); p.close(); }
  File f = LittleFS.open(PATH_QUEUE, "r");
  if (!f) return 0;
  if (queueOffset > f.size()) queueOffset = 0;   // qpos korup -> kirim ulang semua (aman: kunci tetap)
  queueOffsetNext = queueOffset;
  f.seek(queueOffset);
  uint8_t buf[256]; int n = 0, len;
  while ((len = f.read(buf, sizeof(buf))) > 0)
    for (int i=0;i<len;i++) if (buf[i]=='\n') n++;
  f.close();
  return n;
}

void tulisAntrian(JsonDocument& doc) {
  if (xSemaphoreTake(mutexQueue, pdMS_TO_TICKS(2000)) != pdTRUE) {
    Serial.println("  [!!] Antrian sibuk — data HILANG");
    return;
  }
  File f = LittleFS.open(PATH_QUEUE, "a");
  if (f) { serializeJson(doc, f); f.print('\n'); f.close(); antrianSisa++; }
  xSemaphoreGive(mutexQueue);
}

String bacaBarisPertama() {
  String s;
  queueOffsetNext = queueOffset;
  if (xSemaphoreTake(mutexQueue, pdMS_TO_TICKS(500)) != pdTRUE) return s;
  File f = LittleFS.open(PATH_QUEUE, "r");
  if (f) {
    f.seek(queueOffset);
    s = f.readStringUntil('\n');
    queueOffsetNext = f.position();
    f.close();
  }
  xSemaphoreGive(mutexQueue);
  s.trim();
  return s;
}

void hapusBarisPertama() {
  if (xSemaphoreTake(mutexQueue, pdMS_TO_TICKS(500)) != pdTRUE) return;
  queueOffset = queueOffsetNext;
  File f = LittleFS.open(PATH_QUEUE, "r");
  size_t ukuran = f ? f.size() : 0;
  if (f) f.close();
  if (queueOffset >= ukuran) {
    LittleFS.remove(PATH_QUEUE);
    LittleFS.remove(PATH_QPOS);
    queueOffset = queueOffsetNext = 0;
    antrianSisa = 0;
  } else {
    simpanQpos();
    if (antrianSisa > 0) antrianSisa--;
  }
  xSemaphoreGive(mutexQueue);
}

void arsipkanBaris(const char* path, const String& baris) {
