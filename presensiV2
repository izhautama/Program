// ============================================================
int kodeHari(struct tm& t) { return (t.tm_year + 1900) * 1000 + t.tm_yday; }

void simpanStateHarian(const char* uid, uint8_t status) {
  File f = LittleFS.open(PATH_HARIAN, "a");
  if (f) { f.printf("%s %u\n", uid, status); f.close(); }
}

bool pulihkanStateHarian(int kode) {
  File f = LittleFS.open(PATH_HARIAN, "r");
  if (!f) return false;
  String hdr = f.readStringUntil('\n'); hdr.trim();
  if (hdr != "D " + String(kode)) { f.close(); return false; }
  int n = 0;
  while (f.available()) {
    String s = f.readStringUntil('\n'); s.trim();
    int sp = s.indexOf(' ');
    if (sp <= 0) continue;
    int idx = cariKartu(s.substring(0, sp));
    if (idx < 0) continue;
    stateSiswa[idx].status = (StatusSiswaHariIni)s.substring(sp + 1).toInt();
    stateSiswa[idx].terisi = true;
    n++;
  }
  f.close();
  Serial.printf("[STATE] %d state tap hari ini dipulihkan dari flash\n", n);
  return true;
}

void mulaiLogHarian(int kode) {
  File f = LittleFS.open(PATH_HARIAN, "w");
  if (f) { f.printf("D %d\n", kode); f.close(); }
}

void resetStateRam() {
  for (int i=0;i<MAX_KARTU;i++) { stateSiswa[i].terisi=false; stateSiswa[i].status=SISWA_BELUM_TAP; }
}

void cekResetHarian(struct tm& t) {
  if (t.tm_yday == hariTerakhirReset) return;
  resetStateRam();
  for (int i=0;i<MAX_ASING_HARIAN;i++) stateAsing[i].terisi=false;
  jumlahAsingHariIni = 0;
  hariTerakhirReset = t.tm_yday;
  int kode = kodeHari(t);
  if (pulihkanStateHarian(kode)) return;
  mulaiLogHarian(kode);
  Serial.println("[RESET] State harian siswa/asing dibersihkan (hari baru)");
}

