static bool tanggalValid(const char* s) { return strlen(s) == 10 && s[4] == '-' && s[7] == '-' && s[0] == '2'; }

// RTDB REST mengembalikan 401 "Permission denied" baik utk data yg tidak lolos validasi
// MAUPUN akun alat yg belum diberi peran. Bedakan dgn 1 request uji yg pasti diizinkan.
HasilKirim klasifikasi(int code, const String& resp) {
  if (code == 200) return KIRIM_OK;
  if (code == 400) return KIRIM_DITOLAK;
  if (code == 401 && resp.indexOf("ermission") >= 0) {
    return rtdbRequest("GET", "device/inbox", "", nullptr, "&shallow=true") == 200 ? KIRIM_DITOLAK : KIRIM_TRANSIEN;
  }
  return KIRIM_TRANSIEN;                       // jaringan, token, 5xx -> coba lagi / dead-letter
}

HasilKirim kirim(const char* method, const String& path, const String& body) {
  String resp;
  int code = rtdbRequest(method, path, body, &resp);
  return klasifikasi(code, resp);
}

HasilKirim kirimBarisAntrian(const String& baris) {
  StaticJsonDocument<512> in;
  if (deserializeJson(in, baris)) return KIRIM_DITOLAK;
  String tipe = (const char*)(in["tipe"] | "");

  if (tipe == "tap") {
    const char* tgl = in["tanggal"] | "";
    const char* jam = in["jam"] | "";
    const char* uid = in["uid"] | "";
    const char* nis = in["nis"] | "";
    const char* status = in["status"] | "";
    if (!tanggalValid(tgl) || !strlen(uid) || !strlen(nis) || String(in["jabatan"] | "") == "Guru") return KIRIM_DITOLAK;
    bool pulang = strcmp(status, "Pulang") == 0;
    String base = String("attendance/") + nis + "/" + tgl + "/";
    StaticJsonDocument<640> out;
    if (pulang) out[base + "pulang"] = jam;
    else { out[base + "masuk"] = jam; out[base + "status"] = status; }
    JsonObject lg = out.createNestedObject(String("log/") + tgl + "/" + uid + (pulang ? "_P" : "_M"));
    lg["jam"] = jam; lg["nis"] = nis; lg["nama"] = in["nama"] | ""; lg["kelas"] = in["kelas"] | ""; lg["status"] = status;
    String body; serializeJson(out, body);
    return kirim("PATCH", "", body);   // multi-path di root: atomik
  }
  if (tipe == "asing") {
    const char* tgl = in["tanggal"] | "";
    if (!tanggalValid(tgl)) return KIRIM_DITOLAK;
    String body = String("{\"jam\":\"") + (const char*)(in["jam"] | "") + "\"}";
    return kirim("PUT", String("unknown/") + tgl + "/" + (const char*)(in["uid"] | "X"), body);
  }
  if (tipe == "gangguan") {
    StaticJsonDocument<384> out;
    if (in.containsKey("ms")) out["ts"] = in["ms"];
    else out["ts"][".sv"] = "timestamp";      // v11 lama / waktu belum valid -> pakai jam server
    out["jenis"] = in["jenis"] | "Lainnya";
    out["detail"] = in["detail"] | "";
    String body; serializeJson(out, body);
    return kirim("POST", "device/events", body);
  }
  return KIRIM_DITOLAK;
}

