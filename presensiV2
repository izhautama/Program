int parseJamKeMenit(const String& hhmm) {
  int pos = hhmm.indexOf(':');
  if (pos < 0) return -1;
  return hhmm.substring(0,pos).toInt()*60 + hhmm.substring(pos+1).toInt();
}

const char* namaHariIni(struct tm& t) {
  static const char* namaHari[] = {"Minggu","Senin","Selasa","Rabu","Kamis","Jumat","Sabtu"};
  if (t.tm_wday < 0 || t.tm_wday > 6) return "Senin";
  return namaHari[t.tm_wday];
}

String urlEncode(const String& s) {
  String out="";
  for (size_t i=0;i<s.length();i++){
    char c=s[i];
    if (isAlphaNumeric(c)||c=='-'||c=='_'||c=='.'||c=='~') out+=c;
    else { char b[4]; snprintf(b,sizeof(b),"%%%02X",(unsigned char)c); out+=b; }
  }
  return out;
}

int cariKartu(const String& uid) {
  for (int i=0;i<jumlahKartu;i++) if (uid.equals(daftarKartu[i].uid)) return i;
  return -1;
}

int cariJadwal(const char* jenis, const char* kelas, const char* hari) {
  int fallbackUmum = -1;
  for (int i=0;i<jumlahJadwal;i++) {
    if (strcmp(daftarJadwal[i].jenis,jenis)!=0) continue;
    bool kelasSemua = (strcmp(daftarJadwal[i].kelas,"Semua")==0);
    bool hariSemua  = (strcmp(daftarJadwal[i].hari,"Semua")==0);
    if (!(kelasSemua || strcmp(daftarJadwal[i].kelas,kelas)==0)) continue;
    if (!(hariSemua  || strcmp(daftarJadwal[i].hari,hari)==0))   continue;
    if (!kelasSemua && !hariSemua) return i;
    if (fallbackUmum < 0) fallbackUmum = i;
  }
  return fallbackUmum;
}

// ============================================================
//   FIREBASE AUTH — login akun alat & perbarui token (REST)
//   Host berbeda dari RTDB -> koneksi TLS sementara, hanya ±1x/jam.
// ============================================================
String   idToken = "";
String   refreshToken = "";
uint32_t tokenExpiryMs = 0;          // millis() saat token kedaluwarsa
volatile bool authDitolak = false;   // email/password alat salah -> jangan spam login

void rtdbTutup();   // deklarasi maju (didefinisikan di bawah)

bool authPost(const String& url, const String& body, const char* contentType, String& resp) {
  rtdbTutup();   // bebaskan RAM sesi TLS RTDB dulu: ESP32 nyaman dgn 1 sesi TLS
  WiFiClientSecure c; c.setInsecure();
  HTTPClient h; h.setTimeout(HTTP_TIMEOUT_MS);
  if (!h.begin(c, url)) return false;
  h.addHeader("Content-Type", contentType);
  int code = h.POST(body);
  resp = h.getString();
  h.end();
  if (code != 200) Serial.printf("  [AUTH] HTTP %d %s\n", code, resp.substring(0, 160).c_str());
  return code == 200;
}

bool firebaseLogin() {
  String resp;
  StaticJsonDocument<256> req;
  req["email"] = DEVICE_EMAIL; req["password"] = DEVICE_PASSWORD; req["returnSecureToken"] = true;
  String body; serializeJson(req, body);
  bool ok = authPost(String("https://identitytoolkit.googleapis.com/v1/accounts:signInWithPassword?key=") + FIREBASE_API_KEY,
                     body, "application/json", resp);
  if (!ok) {
    if (resp.indexOf("INVALID_LOGIN_CREDENTIALS") >= 0 || resp.indexOf("INVALID_PASSWORD") >= 0 ||
        resp.indexOf("EMAIL_NOT_FOUND") >= 0 || resp.indexOf("API key not valid") >= 0) authDitolak = true;
    return false;
  }
  DynamicJsonDocument doc(3072);   // idToken JWT ±1 KB
  if (deserializeJson(doc, resp)) return false;
  idToken      = (const char*)(doc["idToken"] | "");
  refreshToken = (const char*)(doc["refreshToken"] | "");
  tokenExpiryMs = millis() + (uint32_t)(String((const char*)(doc["expiresIn"] | "3600")).toInt() - 300) * 1000UL;
  authDitolak = false;
  return idToken.length() > 0;
}

bool firebaseRefresh() {
  if (!refreshToken.length()) return firebaseLogin();
  String resp;
  bool ok = authPost(String("https://securetoken.googleapis.com/v1/token?key=") + FIREBASE_API_KEY,
                     "grant_type=refresh_token&refresh_token=" + urlEncode(refreshToken),
                     "application/x-www-form-urlencoded", resp);
  if (!ok) return firebaseLogin();
  DynamicJsonDocument doc(3072);
  if (deserializeJson(doc, resp)) return firebaseLogin();
  idToken      = (const char*)(doc["id_token"] | "");
  refreshToken = (const char*)(doc["refresh_token"] | refreshToken.c_str());
  tokenExpiryMs = millis() + (uint32_t)(String((const char*)(doc["expires_in"] | "3600")).toInt() - 300) * 1000UL;
  return idToken.length() > 0;
}

bool pastikanToken() {
  if (idToken.length() && (int32_t)(tokenExpiryMs - millis()) > 0) return true;
  return idToken.length() ? firebaseRefresh() : firebaseLogin();
}

// ============================================================
//   RTDB REST — satu koneksi HTTPS keep-alive, HANYA dipakai core jaringan
// ============================================================
WiFiClientSecure rtdbClient;
HTTPClient       rtdbHttp;

void rtdbTutup() { rtdbHttp.end(); rtdbClient.stop(); }

String rtdbUrl(const String& path, const char* extra = "") {
  return String(FIREBASE_DB_URL) + "/" + path + ".json?auth=" + idToken + extra;
}

// method: GET/PUT/PATCH/POST. Return kode HTTP (<0 = gagal koneksi).
int rtdbRequest(const char* method, const String& path, const String& body, String* resp, const char* extra = "") {
  if (!pastikanToken()) return -100;
  for (int coba = 0; coba < 2; coba++) {
    if (!rtdbHttp.begin(rtdbClient, rtdbUrl(path, extra))) { rtdbTutup(); continue; }
    rtdbHttp.setReuse(true);
    rtdbHttp.setTimeout(HTTP_TIMEOUT_MS);
    if (body.length()) rtdbHttp.addHeader("Content-Type", "application/json");
    int code = rtdbHttp.sendRequest(method, body);
    String r = code > 0 ? rtdbHttp.getString() : String();
    rtdbHttp.end();   // setReuse(true): koneksi TLS tetap terbuka utk request berikutnya
    if (code < 0) { rtdbTutup(); continue; }          // koneksi basi -> buka ulang sekali
    if (code == 401 && r.indexOf("expired") >= 0 && coba == 0) {   // token habis -> perbarui
      if (!firebaseRefresh()) return 401;
      continue;
    }
    if (resp) *resp = r;
    if (code >= 400) Serial.printf("  [RTDB] %s %s -> %d %s\n", method, path.c_str(), code, r.substring(0, 120).c_str());
    return code;
  }
  return -1;
}

// Unduh path RTDB langsung ke flash (tidak ditampung di RAM)
bool rtdbUnduhKeFile(const String& path, const char* file) {
  if (!pastikanToken()) return false;
  for (int coba = 0; coba < 2; coba++) {
    if (coba) { rtdbTutup(); delay(300); }               // percobaan ke-2: koneksi TLS baru
    if (!rtdbHttp.begin(rtdbClient, rtdbUrl(path))) continue;
    rtdbHttp.setReuse(true);
    rtdbHttp.setTimeout(HTTP_TIMEOUT_MS);
    int code = rtdbHttp.GET();
    if (code == 200) {
      File f = LittleFS.open(file, "w");
      int n = f ? rtdbHttp.writeToStream(&f) : -1;
      if (f) f.close();
      rtdbHttp.end();
      if (n > 0) return true;
      Serial.printf("  [RTDB] unduh %s: tulis flash gagal (%d)\n", path.c_str(), n);
      return false;
    }
    char tls[96] = "";
    rtdbClient.lastError(tls, sizeof(tls));               // penyebab TLS (bila ada)
    Serial.printf("  [RTDB] unduh %s -> %d (%s) TLS:'%s' heap:%u maxblok:%u\n", path.c_str(), code,
                  HTTPClient::errorToString(code).c_str(), tls, ESP.getFreeHeap(), ESP.getMaxAllocHeap());
    rtdbHttp.end();
    if (code > 0) return false;                           // 401/404 dll: bukan masalah koneksi
  }
  rtdbTutup();
  return false;
}

// ============================================================
//   STREAMING PARSE objek RTDB {"kunci":{...},"kunci2":{...}} dari file
//   RAM konstan ±0.5 KB berapa pun jumlah kartu.
// ============================================================
int bacaNonSpasi(File& f) { int c; do { c = f.read(); } while (c == ' ' || c == '\n' || c == '\r' || c == '\t'); return c; }

int streamObject(const char* path, HandlerKV onKV) {
  File f = LittleFS.open(path, "r");
  if (!f) return -1;
  int c = bacaNonSpasi(f);
  if (c == 'n') { f.close(); return 0; }          // "null" = node kosong
  if (c != '{') { f.close(); return -1; }
  StaticJsonDocument<512> doc;
  int n = 0;
  for (;;) {
    c = bacaNonSpasi(f);
    if (c == '}') break;
    if (c != '"') { n = -1; break; }
    String key = f.readStringUntil('"');
    if (bacaNonSpasi(f) != ':') { n = -1; break; }
    if (deserializeJson(doc, f)) { n = -1; break; }
    if (doc.is<JsonObject>() && onKV(key.c_str(), doc.as<JsonObject>())) n++;
    c = bacaNonSpasi(f);
    if (c == ',') continue;
    if (c == '}') break;
    n = -1; break;
  }
  f.close();
  return n;
}

// /config/students/{UID} = {nis, nama, kelas}
bool onKVInduk(const char* key, JsonObject o) {
  if (!key[0]) return false;
  if (jumlahKartu >= MAX_KARTU) { kartuDilewati++; return false; }
  Kartu& k = daftarKartu[jumlahKartu++];
  salin(k.uid,   key,               sizeof(k.uid));
  salin(k.nama,  o["nama"]  | "",   sizeof(k.nama));
  salin(k.kelas, o["kelas"] | "",   sizeof(k.kelas));
  salin(k.nis,   o["nis"]   | "",   sizeof(k.nis));
  for (int c=0; k.uid[c]; c++) k.uid[c] = toupper(k.uid[c]);
  return true;
}

// /config/schedule/{id} = {kelas, hari, jenis, mulai, selesai}
bool onKVJadwal(const char* key, JsonObject o) {
  if (jumlahJadwal >= MAX_JADWAL) return false;
  JadwalRow& j = daftarJadwal[jumlahJadwal++];
  salin(j.kelas, o["kelas"] | "", sizeof(j.kelas));
  salin(j.hari,  o["hari"]  | "", sizeof(j.hari));
  salin(j.jenis, o["jenis"] | "", sizeof(j.jenis));
  j.mulaiMenit   = parseJamKeMenit(String((const char*)(o["mulai"]   | "")));
  j.selesaiMenit = parseJamKeMenit(String((const char*)(o["selesai"] | "")));
  return true;
}

int parseIndukDariFile(const char* path) {
  jumlahKartu = 0; kartuDilewati = 0;
  int n = streamObject(path, onKVInduk);
  if (kartuDilewati) logWARN(String(kartuDilewati) + " kartu melebihi MAX_KARTU, dilewati");
  return n;
