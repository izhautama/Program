}

// v12: salin per 20 baris & lepas mutex di antaranya -> tap baru tidak pernah menunggu lama
int requeueDeadLetter() {
  if (!LittleFS.exists(PATH_DEAD)) return 0;
  LittleFS.remove(PATH_UNDUH_TMP2);
  if (!LittleFS.rename(PATH_DEAD, PATH_UNDUH_TMP2)) return 0;   // ambil alih file (atomik)
  File src = LittleFS.open(PATH_UNDUH_TMP2, "r");
  if (!src) return 0;
  int n = 0;
  while (src.available()) {
    String batch; int isi = 0;
    while (src.available() && isi < 20) {
      String s = src.readStringUntil('\n'); s.trim();
      if (s.length()) { batch += s; batch += '\n'; isi++; }
    }
    if (!isi) break;
    if (xSemaphoreTake(mutexQueue, pdMS_TO_TICKS(2000)) == pdTRUE) {
      File dst = LittleFS.open(PATH_QUEUE, "a");
      if (dst) { dst.print(batch); dst.close(); antrianSisa += isi; n += isi; }
      xSemaphoreGive(mutexQueue);
    } else {
      arsipkanBaris(PATH_DEAD, batch.substring(0, batch.length() - 1));   // kembalikan, coba lagi nanti
    }
    vTaskDelay(pdMS_TO_TICKS(5));
  }
  src.close();
  LittleFS.remove(PATH_UNDUH_TMP2);
  return n;
}

