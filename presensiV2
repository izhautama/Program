// Pasang file hasil unduhan ke RAM secara aman (dipanggil core jaringan saat runtime).
// Core presensi memegang mutexData selama memproses 1 tap, jadi tidak ada data setengah jadi.
bool pasangDataBaru(uint32_t versi) {
  if (xSemaphoreTake(mutexData, pdMS_TO_TICKS(5000)) != pdTRUE) return false;
  int nI = parseIndukDariFile(PATH_UNDUH_TMP);
  int nJ = parseJadwalDariFile(PATH_UNDUH_TMP2);
  bool ok = nI >= 0 && nJ >= 0;
  if (ok) {
    LittleFS.remove(PATH_CACHE_INDUK);  LittleFS.rename(PATH_UNDUH_TMP,  PATH_CACHE_INDUK);
    LittleFS.remove(PATH_CACHE_JADWAL); LittleFS.rename(PATH_UNDUH_TMP2, PATH_CACHE_JADWAL);
    if (versi) { tulisVersiTersimpan(versi); versiDataLokal = versi; }
  } else {
    muatCacheLama();   // file rusak -> kembali ke cache lama
    LittleFS.remove(PATH_UNDUH_TMP); LittleFS.remove(PATH_UNDUH_TMP2);
  }
  // Urutan kartu bisa berubah -> susun ulang state harian dari log flash
  resetStateRam();
  struct tm t;
  if (waktuSekarangTm(t)) pulihkanStateHarian(kodeHari(t));
  xSemaphoreGive(mutexData);
  if (ok) Serial.printf("[DATA] Dimuat ulang: %d kartu, %d jadwal (versi %u)\n", jumlahKartu, jumlahJadwal, versi);
  return ok;
}

// ============================================================
//   STATE MACHINE — SISWA (identik v11.1)
// ============================================================
BatasJamSiswa resolveBatasJamSiswa(const char* kelas, const char* hari) {
  BatasJamSiswa b = { 420,435, 436,850, 855,900, false };
  int iM = cariJadwal("Masuk",     kelas, hari);
  int iT = cariJadwal("Terlambat", kelas, hari);
  int iP = cariJadwal("Pulang",    kelas, hari);
  if (iM<0 || iT<0 || iP<0) return b;
  int mm=daftarJadwal[iM].mulaiMenit, ms=daftarJadwal[iM].selesaiMenit;
  int tm=daftarJadwal[iT].mulaiMenit, ts=daftarJadwal[iT].selesaiMenit;
  int pm=daftarJadwal[iP].mulaiMenit, ps=daftarJadwal[iP].selesaiMenit;
  bool valid = (mm>=0 && ms>=0 && tm>=0 && ts>=0 && pm>=0 && ps>=0)
            && (mm<=ms) && (ms<tm) && (tm<=ts) && (ts<=pm) && (pm<=ps);
  if (!valid) return b;
  return { mm, ms, tm, ts, pm, ps, true };
}

HasilSiswa evaluasiWaktuSiswa(int menit, const BatasJamSiswa& b) {
  if (menit <  b.masukMulai)       return S_TERLALU_AWAL;
  if (menit <= b.masukSelesai)     return S_HADIR;
  if (menit <= b.terlambatSelesai) return S_TERLAMBAT;
  if (menit <  b.pulangMulai)      return S_AKSES_DITUTUP;
  if (menit <= b.pulangSelesai)    return S_PULANG;
  return S_WAKTU_HABIS;
}

void prosesTapSiswa(int idxKartu, Kartu& k, struct tm& t) {
  int menit = menitSejakTengahMalam(t);
  const char* hari = namaHariIni(t);
  BatasJamSiswa batas = resolveBatasJamSiswa(k.kelas, hari);
  HasilSiswa hasil = evaluasiWaktuSiswa(menit, batas);
  char n16[17]; salin(n16, k.nama, sizeof(n16));

  if (!batas.dariSheet) {
    static uint32_t tLogFallback = 0;
    if (millis()-tLogFallback > 60000) {
      tLogFallback = millis();
      antrekanGangguan("Jadwal_Fallback", String("Kelas=")+k.kelas+" Hari="+hari+" pakai default bawaan");
    }
  }

  StateSiswa& st = stateSiswa[idxKartu];
  if (!st.terisi) { st.status = SISWA_BELUM_TAP; st.terisi = true; }

  switch (hasil) {
    case S_TERLALU_AWAL:  buzzerTolak(); lcdShow("Tap Terlalu Awal", n16); return;
    case S_AKSES_DITUTUP: buzzerTolak(); lcdShow("Akses Ditutup", n16);    return;
    case S_WAKTU_HABIS:   buzzerTolak(); lcdShow("Wkt Pulang Habis", n16); return;

    case S_HADIR:
    case S_TERLAMBAT: {
      if (st.status != SISWA_BELUM_TAP) { buzzerTolak(); lcdShow("Sudah Tap Masuk", n16); return; }
      String status = (hasil == S_HADIR) ? "Hadir" : "Terlambat";
      if (hasil == S_HADIR) buzzerHadir(); else buzzerPeringatan();
      lcdShow(n16, String(hasil == S_HADIR ? "Hadir " : "Telat ") + k.nis);
      antrekanTap(formatTanggal(t), formatJam(t), k, status);
      st.status = SISWA_SUDAH_MASUK;
      simpanStateHarian(k.uid, SISWA_SUDAH_MASUK);
      Serial.printf("[SISWA] %s uid=%s nis=%s %s\n", status.c_str(), k.uid, k.nis, k.nama);
      return;
    }
    case S_PULANG: {
      if (st.status == SISWA_SUDAH_PULANG) { buzzerTolak(); lcdShow("Sudah Tap Pulang", n16); return; }
      buzzerHadir(); lcdShow(n16, String("Pulang ") + k.nis);
      antrekanTap(formatTanggal(t), formatJam(t), k, "Pulang");
      st.status = SISWA_SUDAH_PULANG;
      simpanStateHarian(k.uid, SISWA_SUDAH_PULANG);
      Serial.printf("[SISWA] PULANG uid=%s nis=%s %s\n", k.uid, k.nis, k.nama);
      return;
    }
  }
}

void prosesTapAsing(const String& uid, struct tm& t) {
  for (int i=0;i<MAX_ASING_HARIAN;i++) {
    if (stateAsing[i].terisi && uid.equals(stateAsing[i].uid)) { buzzerTolak(); lcdShow("Sudah Tap Hr Ini", uid); return; }
  }
  if (jumlahAsingHariIni < MAX_ASING_HARIAN) {
    salin(stateAsing[jumlahAsingHariIni].uid, uid.c_str(), sizeof(stateAsing[0].uid));
    stateAsing[jumlahAsingHariIni].terisi = true;
    jumlahAsingHariIni++;
  }
  buzzerTolak(); lcdShow("Tdk Terdaftar", uid);
  antrekanAsing(formatTanggal(t), formatJam(t), uid);
  Serial.printf("[ASING] DICATAT uid=%s\n", uid.c_str());
}

// ============================================================
//   TASK PRESENSI — RFID + LCD + Buzzer (CORE_PRESENSI)
// ============================================================
void taskPresensi(void* param) {
  Serial.printf("\n[PRESENSI] task aktif di core %d\n", xPortGetCoreID());
  String uidLama = ""; uint32_t tReset = 0; bool layarTap = false;
  uint32_t layarLamaMs = 2000;
  bool kartuMasihMenempel = false;
  uint32_t tCekHw = 0;

  lcdShow("Tap kartu RFID", "");

  for (;;) {
    // --- Pesan dari core jaringan (LCD / tes buzzer dari web)
    UiPesan ui;
    if (xQueueReceive(uiQueue, &ui, 0) == pdTRUE) {
      if (ui.jenis == UI_LCD) {
        lcdShow(ui.baris1, ui.baris2);
        layarTap = true; tReset = millis(); layarLamaMs = (uint32_t)ui.detik * 1000UL;
      } else if (ui.jenis == UI_BUZZER_TES) {
        lcdShow("Tes Buzzer", "dari admin web");
        buzzerHadir(); delay(250); buzzerPeringatan(); delay(250); buzzerTolak();
        layarTap = true; tReset = millis(); layarLamaMs = 2000;
      }
    }

    // --- Self-check perangkat keras berkala (hasil dibaca core jaringan utk diagnostik)
    if (!layarTap && millis() - tCekHw > 30000) {
      tCekHw = millis();
      byte v = mfrc522.PCD_ReadRegister(MFRC522::VersionReg);
      rfidVersion = v; rfidOK = !(v == 0x00 || v == 0xFF);
      if (!rfidOK) { mfrc522.PCD_Init(); }       // coba pulihkan otomatis
      if (xSemaphoreTake(mutexLCD, pdMS_TO_TICKS(50)) == pdTRUE) {
        Wire.beginTransmission(0x27); lcdOK = (Wire.endTransmission() == 0);
        xSemaphoreGive(mutexLCD);
      }
    }

    bool adaKartu = mfrc522.PICC_IsNewCardPresent() && mfrc522.PICC_ReadCardSerial();
    if (adaKartu) {
      String uid = formatUID(mfrc522.uid.uidByte, mfrc522.uid.size);
      mfrc522.PICC_HaltA(); mfrc522.PCD_StopCrypto1();

      if (kartuMasihMenempel && uid == uidLama) { vTaskDelay(pdMS_TO_TICKS(50)); continue; }
      kartuMasihMenempel = true;
      uidLama = uid;
      lastTapMs = millis();

      struct tm t;
      if (!waktuSekarangTm(t)) {
        buzzerTolak(); lcdShow("Waktu Tdk Valid", "Hubungi Admin");
      } else if (xSemaphoreTake(mutexData, pdMS_TO_TICKS(3000)) != pdTRUE) {
        buzzerTolak(); lcdShow("Memuat data...", "Tap lagi");    // reload data sedang berjalan
      } else {
        cekResetHarian(t);
        if (t.tm_wday == 0) {
          buzzerTolak(); lcdShow("Hari Libur", "Minggu");
        } else {
          int idx = cariKartu(uid);
          if (idx >= 0) prosesTapSiswa(idx, daftarKartu[idx], t);
          else          prosesTapAsing(uid, t);
        }
        xSemaphoreGive(mutexData);
      }
      layarTap = true; tReset = millis(); layarLamaMs = 2000;
    } else {
      kartuMasihMenempel = false;
    }

    if (layarTap && millis()-tReset > layarLamaMs) { layarTap = false; lcdShow("Tap kartu RFID",""); }

    static uint32_t tStat = 0;
    if (!layarTap && millis()-tStat > 1000) { tStat = millis(); lcdStatus(); }

    vTaskDelay(pdMS_TO_TICKS(30));
  }
}

