void   tulisLastCmd(const String& id) { File f = LittleFS.open(PATH_LASTCMD, "w"); if (f) { f.print(id); f.close(); } }

void kirimUi(UiJenis j, const String& l1 = "", const String& l2 = "", uint16_t detik = 2) {
  UiPesan p; p.jenis = j; p.detik = detik;
  salin(p.baris1, l1.c_str(), sizeof(p.baris1));
